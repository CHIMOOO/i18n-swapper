{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "npm: dev",
      "type": "npm",
      "script": "dev",
      "isBackground": true,
      "problemMatcher": [
        {
          "pattern": {
            "regexp": "^✗ Build failed",
            "file": 1,
            "location": 2,
            "message": 3
          },
          "background": {
            "activeOnStart": true,
            "beginsPattern": "^\\[esbuild\\] Watching|vite",
            "endsPattern": "^\\[esbuild\\] Build complete|built in"
          }
        }
      ],
      "presentation": {
        "reveal": "silent"
      },
      "group": "build"
    },
    {
      "label": "npm: build",
      "type": "npm",
      "script": "build",
      "problemMatcher": ["$tsc"],
      "presentation": {
        "reveal": "silent"
      },
      "group": "build"
    }
  ]
}
